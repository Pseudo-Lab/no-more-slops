# API server credentials (optional on localhost; use for shared deployment)
CAD_API_KEY=
CAD_DATA_DIR=./data
CAD_WORKERS=1
CAD_ALGORITHM_REVISION=geometry-local-route-v15-semantics
CAD_JOB_TIMEOUT_SECONDS=1800
CAD_MAX_UPLOAD_BYTES=20971520
CAD_MAX_IMAGE_PIXELS=25000000
CAD_MAX_PENDING_JOBS=32
# Optional trusted server-side legend root (experiments/legend_*.json + image/).
# CAD_RESOURCES_DIR=/absolute/path/to/cad-jev

# Default model connection; extraction clients never supply raw endpoint URLs.
CAD_MODEL_PROVIDER=typesafe
CAD_MODEL_ENDPOINT=https://api.typesafe.ai
CAD_MODEL_NAME=jev-1.14.0
CAD_MODEL_API_KEY_ENV=TYPESAFE_API_KEY
CAD_MODEL_TIMEOUT_SECONDS=90
CAD_MODEL_CONCURRENCY=8
CAD_MODEL_MAX_REQUEST_TOKENS=24000
# TYPESAFE_API_KEY=your-model-service-key

# Alternatively register several named services using models.example.json.
# CAD_MODEL_BACKENDS_FILE=./models.json
